# Database connection
DB_HOST=db
DB_PORT=3306
DB_NAME=codehistory
DB_USER=root
DB_PASSWORD=your_secure_mysql_password_here
MYSQL_ROOT_PASSWORD=your_secure_mysql_password_here

# JWT Security (Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=change_me_to_a_minimum_32_character_random_string_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=30
COOKIE_SECURE=False
COOKIE_SAMESITE=lax
CORS_ORIGINS=http://localhost:3000

# Database auto-migration
AUTO_CREATE_TABLES=True

# Rate Limiting & Logs
LOG_LEVEL=INFO
RATELIMIT_ENABLED=True

# AI Configuration
CODE_MODEL_NAME=deepseek-ai/deepseek-coder-1.3b-base
MAX_TOKENS=256
QUANTIZE=True
USE_GPU=False
USE_OFFLOAD=False
PRELOAD_MODELS=True
TRANSLATE_PROMPTS=True
INTENT_MODEL=typeform/distilbert-base-uncased-mnli
GEN_QUEUE_TIMEOUT=120
SANDBOX_MODE=off

